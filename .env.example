# 로컬 프록시와 Vercel rewrite를 사용하려면 비워 둡니다.
# 운영 브라우저에서 HTTP 백엔드 주소를 직접 지정하면 mixed-content로 차단됩니다.
VITE_API_BASE_URL=

# 로컬 개발 프록시 대상입니다. 실제 AWS 주소가 확정되면 설정하세요.
VITE_API_PROXY_TARGET=http://3.19.74.97

# 관리자 역할 로그인 성공 후 이동할 관리자 웹 주소입니다.
# 관리자 웹을 별도 배포하면 해당 HTTPS URL로 설정합니다.
# 로컬에서는 http://localhost:5174, 운영 기본값은 현재 도메인의 /admin입니다.
# 별도 관리자 도메인을 사용할 때만 설정하세요.
VITE_ADMIN_APP_URL=

# 관리자 로그아웃 후 이동할 학생 웹 주소입니다.
# 관리자 웹을 별도 배포하면 학생 웹의 HTTPS URL로 설정합니다.
VITE_STUDENT_APP_URL=http://localhost:5173
